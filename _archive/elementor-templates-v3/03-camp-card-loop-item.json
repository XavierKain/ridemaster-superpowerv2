{
  "version": "0.4",
  "title": "Camp Card - Loop Item Template",
  "type": "jet-engine",
  "content": [
    {
      "id": "camp-card-main",
      "elType": "container",
      "isInner": false,
      "settings": {
        "flex_direction": "column",
        "background_background": "classic",
        "background_color": "#FFFFFF",
        "border_radius": {
          "top": "16",
          "right": "16",
          "bottom": "16",
          "left": "16",
          "unit": "px",
          "isLinked": true
        },
        "box_shadow_box_shadow_type": "yes",
        "box_shadow_box_shadow": {
          "horizontal": 0,
          "vertical": 2,
          "blur": 8,
          "spread": 0,
          "color": "rgba(0,0,0,0.08)"
        },
        "padding": {
          "top": "0",
          "right": "0",
          "bottom": "0",
          "left": "0",
          "unit": "px",
          "isLinked": true
        }
      },
      "elements": [
        {
          "id": "card-image-container",
          "elType": "container",
          "isInner": true,
          "settings": {
            "position": "relative",
            "padding": {
              "top": "0",
              "right": "0",
              "bottom": "0",
              "left": "0",
              "unit": "px",
              "isLinked": true
            }
          },
          "elements": [
            {
              "id": "card-image",
              "elType": "widget",
              "widgetType": "jet-engine-listing-dynamic-image",
              "settings": {
                "dynamic_image_source": "featured_image",
                "dynamic_image_size": "medium_large",
                "image_border_radius": {
                  "top": "16",
                  "right": "16",
                  "bottom": "0",
                  "left": "0",
                  "unit": "px",
                  "isLinked": false
                },
                "linked_image": "yes",
                "image_width": {
                  "unit": "%",
                  "size": "100"
                },
                "image_height": {
                  "unit": "px",
                  "size": "240"
                },
                "object-fit": "cover"
              },
              "elements": []
            },
            {
              "id": "card-badges",
              "elType": "container",
              "isInner": true,
              "settings": {
                "position": "absolute",
                "position_top": {
                  "unit": "px",
                  "size": "12"
                },
                "position_left": {
                  "unit": "px",
                  "size": "12"
                },
                "flex_direction": "row",
                "flex_gap": {
                  "column": "8",
                  "row": "0",
                  "unit": "px"
                },
                "z_index": 10
              },
              "elements": [
                {
                  "id": "badge-sport",
                  "elType": "widget",
                  "widgetType": "jet-engine-listing-dynamic-terms",
                  "settings": {
                    "from_tax": "sport",
                    "show_all_terms": "yes",
                    "terms_num": 1,
                    "terms_delimiter": ", ",
                    "hide_if_empty": "yes",
                    "background_background": "classic",
                    "background_color": "#14B8A6",
                    "color": "#FFFFFF",
                    "padding": {
                      "top": "4",
                      "right": "12",
                      "bottom": "4",
                      "left": "12",
                      "unit": "px",
                      "isLinked": false
                    },
                    "border_radius": {
                      "top": "12",
                      "right": "12",
                      "bottom": "12",
                      "left": "12",
                      "unit": "px",
                      "isLinked": true
                    },
                    "typography_typography": "custom",
                    "typography_font_family": "DM Sans",
                    "typography_font_weight": "500",
                    "typography_font_size": {
                      "unit": "px",
                      "size": "12"
                    }
                  },
                  "elements": []
                },
                {
                  "id": "badge-level",
                  "elType": "widget",
                  "widgetType": "jet-engine-listing-dynamic-field",
                  "settings": {
                    "dynamic_field_source": "level",
                    "hide_if_empty": "yes",
                    "background_background": "classic",
                    "background_color": "rgba(255, 255, 255, 0.9)",
                    "color": "#0F172A",
                    "padding": {
                      "top": "4",
                      "right": "12",
                      "bottom": "4",
                      "left": "12",
                      "unit": "px",
                      "isLinked": false
                    },
                    "border_radius": {
                      "top": "12",
                      "right": "12",
                      "bottom": "12",
                      "left": "12",
                      "unit": "px",
                      "isLinked": true
                    },
                    "typography_typography": "custom",
                    "typography_font_family": "DM Sans",
                    "typography_font_weight": "500",
                    "typography_font_size": {
                      "unit": "px",
                      "size": "12"
                    }
                  },
                  "elements": []
                }
              ]
            }
          ]
        },
        {
          "id": "card-content",
          "elType": "container",
          "isInner": true,
          "settings": {
            "flex_direction": "column",
            "flex_gap": {
              "column": "12",
              "row": "0",
              "unit": "px"
            },
            "padding": {
              "top": "16",
              "right": "16",
              "bottom": "16",
              "left": "16",
              "unit": "px",
              "isLinked": true
            }
          },
          "elements": [
            {
              "id": "card-title",
              "elType": "widget",
              "widgetType": "jet-engine-listing-dynamic-field",
              "settings": {
                "dynamic_field_source": "post_title",
                "dynamic_field_tag": "h3",
                "linked_field": "yes",
                "color": "#0F172A",
                "typography_typography": "custom",
                "typography_font_family": "DM Sans",
                "typography_font_weight": "600",
                "typography_font_size": {
                  "unit": "px",
                  "size": "18"
                },
                "typography_line_height": {
                  "unit": "em",
                  "size": "1.4"
                }
              },
              "elements": []
            },
            {
              "id": "card-location",
              "elType": "container",
              "isInner": true,
              "settings": {
                "flex_direction": "row",
                "flex_align_items": "center",
                "flex_gap": {
                  "column": "6",
                  "row": "0",
                  "unit": "px"
                }
              },
              "elements": [
                {
                  "id": "location-icon",
                  "elType": "widget",
                  "widgetType": "icon",
                  "settings": {
                    "icon": {
                      "value": "fas fa-map-marker-alt",
                      "library": "fa-solid"
                    },
                    "icon_color": "#64748B",
                    "size": {
                      "unit": "px",
                      "size": "14"
                    }
                  },
                  "elements": []
                },
                {
                  "id": "location-text",
                  "elType": "widget",
                  "widgetType": "jet-engine-listing-dynamic-field",
                  "settings": {
                    "dynamic_field_source": "location",
                    "hide_if_empty": "yes",
                    "color": "#64748B",
                    "typography_typography": "custom",
                    "typography_font_family": "DM Sans",
                    "typography_font_weight": "400",
                    "typography_font_size": {
                      "unit": "px",
                      "size": "14"
                    }
                  },
                  "elements": []
                }
              ]
            },
            {
              "id": "card-dates",
              "elType": "container",
              "isInner": true,
              "settings": {
                "flex_direction": "row",
                "flex_align_items": "center",
                "flex_gap": {
                  "column": "6",
                  "row": "0",
                  "unit": "px"
                }
              },
              "elements": [
                {
                  "id": "dates-icon",
                  "elType": "widget",
                  "widgetType": "icon",
                  "settings": {
                    "icon": {
                      "value": "fas fa-calendar",
                      "library": "fa-solid"
                    },
                    "icon_color": "#64748B",
                    "size": {
                      "unit": "px",
                      "size": "14"
                    }
                  },
                  "elements": []
                },
                {
                  "id": "dates-text",
                  "elType": "widget",
                  "widgetType": "jet-engine-listing-dynamic-field",
                  "settings": {
                    "dynamic_field_source": "start_date",
                    "date_format": "M j",
                    "hide_if_empty": "yes",
                    "color": "#64748B",
                    "typography_typography": "custom",
                    "typography_font_family": "DM Sans",
                    "typography_font_weight": "400",
                    "typography_font_size": {
                      "unit": "px",
                      "size": "14"
                    }
                  },
                  "elements": []
                },
                {
                  "id": "dates-separator",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p>-</p>",
                    "color": "#64748B",
                    "_margin": {
                      "top": "0",
                      "right": "0",
                      "bottom": "0",
                      "left": "0",
                      "unit": "px",
                      "isLinked": true
                    }
                  },
                  "elements": []
                },
                {
                  "id": "dates-end",
                  "elType": "widget",
                  "widgetType": "jet-engine-listing-dynamic-field",
                  "settings": {
                    "dynamic_field_source": "end_date",
                    "date_format": "M j, Y",
                    "hide_if_empty": "yes",
                    "color": "#64748B",
                    "typography_typography": "custom",
                    "typography_font_family": "DM Sans",
                    "typography_font_weight": "400",
                    "typography_font_size": {
                      "unit": "px",
                      "size": "14"
                    }
                  },
                  "elements": []
                }
              ]
            },
            {
              "id": "card-rating",
              "elType": "container",
              "isInner": true,
              "settings": {
                "flex_direction": "row",
                "flex_align_items": "center",
                "flex_gap": {
                  "column": "6",
                  "row": "0",
                  "unit": "px"
                }
              },
              "elements": [
                {
                  "id": "rating-stars",
                  "elType": "widget",
                  "widgetType": "star-rating",
                  "settings": {
                    "rating": 5,
                    "star_style": "star_fontawesome",
                    "unmarked_star_style": "solid",
                    "icon_color": "#FCD34D",
                    "icon_unmarked_color": "#E5E7EB",
                    "star_size": {
                      "unit": "px",
                      "size": "16"
                    }
                  },
                  "elements": []
                },
                {
                  "id": "rating-value",
                  "elType": "widget",
                  "widgetType": "jet-engine-listing-dynamic-field",
                  "settings": {
                    "dynamic_field_source": "rating",
                    "hide_if_empty": "yes",
                    "color": "#0F172A",
                    "typography_typography": "custom",
                    "typography_font_family": "DM Sans",
                    "typography_font_weight": "600",
                    "typography_font_size": {
                      "unit": "px",
                      "size": "14"
                    }
                  },
                  "elements": []
                },
                {
                  "id": "rating-count",
                  "elType": "widget",
                  "widgetType": "jet-engine-listing-dynamic-field",
                  "settings": {
                    "dynamic_field_source": "reviews_count",
                    "field_before_template": "(",
                    "field_after_template": ")",
                    "hide_if_empty": "yes",
                    "color": "#64748B",
                    "typography_typography": "custom",
                    "typography_font_family": "DM Sans",
                    "typography_font_weight": "400",
                    "typography_font_size": {
                      "unit": "px",
                      "size": "14"
                    }
                  },
                  "elements": []
                }
              ]
            },
            {
              "id": "card-footer",
              "elType": "container",
              "isInner": true,
              "settings": {
                "flex_direction": "row",
                "flex_justify_content": "space-between",
                "flex_align_items": "center",
                "padding": {
                  "top": "12",
                  "right": "0",
                  "bottom": "0",
                  "left": "0",
                  "unit": "px",
                  "isLinked": false
                },
                "border_border": "solid",
                "border_width": {
                  "top": "1",
                  "right": "0",
                  "bottom": "0",
                  "left": "0",
                  "unit": "px",
                  "isLinked": false
                },
                "border_color": "#E2E8F0"
              },
              "elements": [
                {
                  "id": "coach-info",
                  "elType": "container",
                  "isInner": true,
                  "settings": {
                    "flex_direction": "row",
                    "flex_align_items": "center",
                    "flex_gap": {
                      "column": "8",
                      "row": "0",
                      "unit": "px"
                    }
                  },
                  "elements": [
                    {
                      "id": "coach-avatar",
                      "elType": "widget",
                      "widgetType": "jet-engine-listing-dynamic-image",
                      "settings": {
                        "dynamic_image_source": "coach_avatar",
                        "dynamic_image_source_custom": "_thumbnail_id",
                        "dynamic_image_size": "thumbnail",
                        "image_width": {
                          "unit": "px",
                          "size": "32"
                        },
                        "image_height": {
                          "unit": "px",
                          "size": "32"
                        },
                        "image_border_radius": {
                          "top": "50",
                          "right": "50",
                          "bottom": "50",
                          "left": "50",
                          "unit": "%",
                          "isLinked": true
                        },
                        "object-fit": "cover"
                      },
                      "elements": []
                    },
                    {
                      "id": "coach-name",
                      "elType": "widget",
                      "widgetType": "jet-engine-listing-dynamic-field",
                      "settings": {
                        "dynamic_field_source": "coach_name",
                        "hide_if_empty": "yes",
                        "color": "#0F172A",
                        "typography_typography": "custom",
                        "typography_font_family": "DM Sans",
                        "typography_font_weight": "500",
                        "typography_font_size": {
                          "unit": "px",
                          "size": "14"
                        }
                      },
                      "elements": []
                    }
                  ]
                },
                {
                  "id": "price-info",
                  "elType": "container",
                  "isInner": true,
                  "settings": {
                    "flex_direction": "row",
                    "flex_align_items": "baseline",
                    "flex_gap": {
                      "column": "4",
                      "row": "0",
                      "unit": "px"
                    }
                  },
                  "elements": [
                    {
                      "id": "price-amount",
                      "elType": "widget",
                      "widgetType": "jet-engine-listing-dynamic-field",
                      "settings": {
                        "dynamic_field_source": "price",
                        "field_before_template": "€",
                        "hide_if_empty": "yes",
                        "color": "#0F172A",
                        "typography_typography": "custom",
                        "typography_font_family": "DM Sans",
                        "typography_font_weight": "700",
                        "typography_font_size": {
                          "unit": "px",
                          "size": "18"
                        }
                      },
                      "elements": []
                    },
                    {
                      "id": "price-unit",
                      "elType": "widget",
                      "widgetType": "text-editor",
                      "settings": {
                        "editor": "<p>/person</p>",
                        "color": "#64748B",
                        "typography_typography": "custom",
                        "typography_font_family": "DM Sans",
                        "typography_font_weight": "400",
                        "typography_font_size": {
                          "unit": "px",
                          "size": "14"
                        },
                        "_margin": {
                          "top": "0",
                          "right": "0",
                          "bottom": "0",
                          "left": "0",
                          "unit": "px",
                          "isLinked": true
                        }
                      },
                      "elements": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "page_settings": []
}
